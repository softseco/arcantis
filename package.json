{
  "name": "@softseco/arcantis",
  "version": "1.0.0-rc.1",
  "license": "BUSL-1.1",
  "description": "Arcantis: TypeScript SDK for Token-2022 confidential transfers on Solana: configure, deposit, apply, transfer, withdraw, decrypt.",
  "keywords": [
    "solana",
    "token-2022",
    "arcantis",
    "confidential-transfers",
    "confidential-balances",
    "zero-knowledge",
    "elgamal",
    "privacy",
    "stablecoin",
    "sdk"
  ],
  "author": "Joachim Szamborski (Softseco)",
  "homepage": "https://github.com/softseco/arcantis#readme",
  "bugs": {
    "url": "https://github.com/softseco/arcantis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softseco/arcantis.git"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "arcantis": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsup && tsc --emitDeclarationOnly",
    "docs:api": "typedoc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "test": "tsx node_modules/mocha/bin/_mocha --timeout 120000 \"test/**/*.test.ts\"",
    "test:browser": "tsx test/browser/e2e.ts",
    "coverage": "c8 --all --include 'src/**' --reporter=text --reporter=html tsx node_modules/mocha/bin/_mocha --timeout 120000 \"test/**/*.test.ts\"",
    "example": "tsx examples/confidential-transfer.ts",
    "example:devnet": "tsx examples/devnet.ts",
    "example:devnet-mint": "tsx examples/devnet-mint.ts",
    "example:mainnet": "tsx examples/mainnet.ts",
    "validator": "bash scripts/start-test-validator.sh",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token-2022": "^0.19.0",
    "@solana-program/zk-elgamal-proof": "^0.4.0",
    "@solana/sysvars": "^8.3.0",
    "@solana/zk-sdk": "^0.5.3"
  },
  "peerDependencies": {
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@solana/kit": "^8.3.0",
    "@types/chai": "^4.3.14",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.0",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@wallet-standard/wallet": "^1.1.1",
    "c8": "^10.1.3",
    "chai": "^4.4.1",
    "esbuild": "^0.27.7",
    "mocha": "^10.4.0",
    "playwright-core": "^1.64.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.5"
  }
}
